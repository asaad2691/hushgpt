FLASK_ENV=development
SECRET_KEY=change-me
APP_API_KEY=dev-local-key
MODEL_PROVIDER=huggingface
HUGGINGFACE_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
HUGGINGFACE_LOCAL_DIR=
HUGGINGFACE_AUTO_DOWNLOAD=true
HUGGINGFACE_MAX_NEW_TOKENS=1024
HUGGINGFACE_TEMPERATURE=0.7
HUGGINGFACE_TOP_P=0.9
HUGGINGFACE_DO_SAMPLE=true
HUGGINGFACE_USE_FAST_TOKENIZER=true
HUGGINGFACE_CACHE_DIR=
HUGGINGFACE_HUB_TOKEN=
IMAGE_READER_MODEL=Salesforce/blip-image-captioning-large
IMAGE_READER_MAX_NEW_TOKENS=512
WARMUP_IMAGE_ANALYZER=true
IMAGE_OCR_LANGUAGES=en
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_MODEL=stabilityai/stable-diffusion-2-1
IMAGE_GENERATION_STEPS=25
IMAGE_GENERATION_GUIDANCE_SCALE=7.5
IMAGE_EDIT_STRENGTH=0.55
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Leave DATABASE_URL empty to use the MySQL defaults below.
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=local_ai
SYSTEM_PROMPT=You are a helpful local assistant. Give concise direct answers by default and expand only when the user asks for detailed output. Follow local app policy and refuse harmful requests.
MAX_HISTORY_MESSAGES=12
RETRIEVAL_MAX_SNIPPETS=4
REQUEST_TIMEOUT=120
FILE_MAX_NEW_TOKENS=1200
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MAX_CHARS=1200
VECTOR_SEARCH_TOP_K=5
VISION_MODEL_ID=Qwen/Qwen2-VL-2B-Instruct
VISION_FALLBACK_TO_OCR=true
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_MAX_RESULTS=3
JOB_RUNNER_MODE=embedded
JOB_POLL_INTERVAL=1.0
JOB_STALE_SECONDS=900
JOB_RETRY_LIMIT=2
FILE_RETENTION_DAYS=14
AUTO_STORAGE_CLEANUP=true
